{
  "name": "handball-stats",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "models:prepare": "node scripts/prepare-needle-models.mjs",
    "build": "npm run models:prepare && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"public/**/*.js\" \"*.ts\" tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"public/**/*.js\" \"*.ts\" tsconfig.json package.json .prettierrc.json",
    "mobile:build": "npm run check && node scripts/native-licenses.mjs && node scripts/build-native.mjs",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:assets": "node scripts/native-resources.mjs",
    "mobile:android": "npm run mobile:sync && cd android && ./gradlew :app:assembleDebug :app:bundleRelease",
    "mobile:verify:android": "uv run scripts/verify-android.py",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "stores:check": "node scripts/stores-check.mjs",
    "stores:licenses": "node scripts/native-licenses.mjs",
    "stores:privacy": "node scripts/store-privacy.mjs",
    "stores:capture": "playwright test --config=playwright.stores.config.ts",
    "stores:package": "node scripts/package-mobile.mjs",
    "test:native-assets": "playwright test --config=playwright.native.config.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "cactus-needle": "0.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
